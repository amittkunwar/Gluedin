<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ott_background">

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="56dp">

            <ImageView
                android:id="@+id/ivDetailBackdrop"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:contentDescription="Poster Backdrop"
                android:scaleType="centerCrop"
                app:layout_constraintBottom_toBottomOf="@+id/viewScrim"
                app:layout_constraintTop_toTopOf="parent"
                tools:background="@color/ott_surface" />

            <View
                android:id="@+id/viewScrim"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/gradient_scrim_bottom"
                app:layout_constraintBottom_toBottomOf="@+id/btnPlayVideo"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/llBadges"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="260dp"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/tvBadgeRating"
                    style="@style/OttBadgePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    tools:text="U/A 16+" />

                <TextView
                    android:id="@+id/tvBadgeYear"
                    style="@style/OttBadgePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    tools:text="2024" />

                <TextView
                    android:id="@+id/tvBadgeDuration"
                    style="@style/OttBadgePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_badge_pill"
                    tools:text="12m 14s" />

                <TextView
                    android:id="@+id/tvBadgeCategory"
                    style="@style/OttBadgePill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_badge_pill"
                    android:textColor="@color/ott_accent_cyan"
                    tools:text="Sci-Fi Thriller" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="14dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.02"
                android:lineSpacingMultiplier="0.95"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="34sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/llBadges"
                tools:text="Cosmic Odyssey" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayVideo"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="20dp"
                android:backgroundTint="@color/ott_accent_red"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Play Now"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@color/white"
                app:layout_constraintTop_toBottomOf="@+id/tvDetailTitle" />

            <LinearLayout
                android:id="@+id/layoutHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/btnPlayVideo">

                <TextView
                    android:id="@+id/tvOverviewHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Storyline"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDetailDescription"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="12dp"
                android:lineSpacingExtra="6dp"
                android:textColor="@color/text_secondary"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/layoutHeading"
                tools:text="Set in a dystopian future, a group of warriors and scientists gather at the Oude Kerk in Amsterdam to stage a desperate attempt to rescue the world from destructive robotics." />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="center"
        android:indeterminateTint="@color/ott_accent_red"
        android:visibility="gone" />

    <!-- Declared last so it floats above the scroll content -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#66101018"
        app:cardCornerRadius="22dp"
        app:cardElevation="0dp"
        app:strokeColor="#26FFFFFF"
        app:strokeWidth="1dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
