<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="540dp">

    <ImageView
        android:id="@+id/ivHeroBanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="Hero Banner"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:background="@color/ott_surface" />

    <!-- Fades fully into the page background for a seamless blend into the rails -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/gradient_scrim_bottom"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFeaturedTag"
        style="@style/OttBadgePill"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_badge_accent"
        android:letterSpacing="0.12"
        android:text="★  FEATURED PREMIERE"
        android:textColor="@color/ott_accent_red"
        android:textSize="10sp"
        app:layout_constraintBottom_toTopOf="@+id/tvHeroTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/tvHeroTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="12dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.02"
        android:lineSpacingMultiplier="0.95"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="38sp"
        app:layout_constraintBottom_toTopOf="@+id/llBadges"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Cosmic Odyssey" />

    <LinearLayout
        android:id="@+id/llBadges"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginBottom="14dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toTopOf="@+id/tvHeroDescription"
        app:layout_constraintStart_toStartOf="parent">

        <TextView
            android:id="@+id/tvHeroRating"
            style="@style/OttBadgePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_badge_pill"
            tools:text="U/A 16+" />

        <TextView
            android:id="@+id/tvHeroCategory"
            style="@style/OttBadgePill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_pill"
            android:textColor="@color/ott_accent_cyan"
            tools:text="Sci-Fi Thriller" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvHeroDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="22dp"
        android:ellipsize="end"
        android:lineSpacingExtra="4dp"
        android:maxLines="2"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/llHeroActions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        tools:text="Set in a dystopian future, a group of scientists and navigators venture into deep space to stage a desperate attempt to rescue humanity." />

    <LinearLayout
        android:id="@+id/llHeroActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeroPlay"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:backgroundTint="@color/ott_accent_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Play"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_play_arrow"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/white" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHeroDetails"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:backgroundTint="#1FFFFFFF"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="More Info"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="26dp"
            app:icon="@drawable/ic_info_outline"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@color/white"
            app:strokeColor="#4DFFFFFF"
            app:strokeWidth="1dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
